{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3000",
    "http://localhost:5173",
    "https://localhost:3000",
    "https://localhost:5173"
  ],
  "ConnectionStrings": {
    "DefaultConnection": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV"
  },
  "AppSettings": {
    "Secret": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "Issuer": "KoiFengShuiSystem",
    "Audience": "KoiFengShuiSystemClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "MailSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "KoiFengShuiSystem",
    "SenderEmail": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "UserName": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "Password": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "UseSSL": false,
    "UseStartTls": true
  },

  "AdminAccount": {
    "Email": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "Password": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV"
  },
  "ImageStorage": {
    "BasePath": "./images"
  },
  "CloundSettings": {
    "CloundName": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "CloundKey": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV",
    "CloundSecret": "ROTATE_ME__SET_VIA_USER_SECRETS_OR_ENV"
  }
}
